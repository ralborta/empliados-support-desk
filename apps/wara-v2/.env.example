# Local V2 only — never production credentials
WARA_V2_EXECUTION_MODE=dry_run
WARA_V2_ALLOW_WARA_MUTATIONS=false
WARA_V2_ALLOW_ODOO_MUTATIONS=false
WARA_V2_ALLOW_WHATSAPP_SEND=false
# Nunca reutilizar DATABASE_URL de V1/prod
WARA_V2_DATABASE_URL=postgresql://wara_v2:wara_v2_local_dev_only@127.0.0.1:5433/wara_v2
REDIS_URL=redis://:wara_v2_local_dev_only@127.0.0.1:6380/0

# Fase 8 LLM (opcional, fail-closed — todas requeridas para adaptador real)
# REAL_MODEL_ENABLED=true
# SHADOW_MODE=true
# DELIVERY_ENABLED=false
# V2_MUTATIONS_DISABLED=true
# ALLOW_EXTERNAL_MUTATIONS=false
# REAL_CHANNELS_ENABLED=false
# SYNTHETIC_DATA_ONLY=true
# WARA_V2_LLM_PROVIDER=openai
# WARA_V2_LLM_MODEL=gpt-4o-mini
# WARA_V2_ENV=local
# WARA_V2_BIND_HOST=127.0.0.1
# OPENAI_API_KEY= # never commit; never use prod keys here
# WARA_V2_LLM_MODEL=gpt-4o-mini-2024-07-18
# WARA_V2_LLM_ALLOW_ALIAS=true # solo experimento no oficial con alias gpt-4o-mini
# WARA_V2_LLM_LIVE=true # solo harness eval live
